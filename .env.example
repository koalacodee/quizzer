# PostgreSQL connection string (on Neon: the pooled connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quizzer

# Optional: direct (non-pooled) connection used for migrations and seeding.
# The Neon ↔ Vercel integration sets this automatically.
# DATABASE_URL_UNPOOLED=

# Password for the /admin area
ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies (any long random string)
SESSION_SECRET=replace-with-a-long-random-string
